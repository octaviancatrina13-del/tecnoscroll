# ─────────────────────────────────────────────────────────────
# TecnoScroll — variables de entorno
# Copia este archivo a `.env` y rellena las claves.
# En GitHub Actions / Netlify, configúralas como "secrets".
# NUNCA subas el archivo .env real al repositorio.
# ─────────────────────────────────────────────────────────────

# Reescritura de artículos (obligatoria para el pipeline)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modelo de Claude usado para reescribir (opcional; hay valor por defecto)
# claude-haiku-4-5 = más barato (recomendado para flujo rápido).
# Alternativa de más calidad: claude-sonnet-5
ANTHROPIC_MODEL=claude-haiku-4-5

# Imágenes con licencia (al menos una recomendada)
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# https://www.pexels.com/api/
PEXELS_API_KEY=
# Opcional — Openverse no requiere clave, pero puedes registrar una app para más cuota
# https://api.openverse.org/
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Ajustes del pipeline (opcionales)
# Máximo de artículos nuevos a procesar por ejecución (controla coste de API)
# Con cron cada 8 h => ~40-50 noticias nuevas por tanda.
MAX_ARTICLES_PER_RUN=45
# Idioma de salida (por si algún día quieres otra edición)
OUTPUT_LANG=es

# URL pública final del sitio (para SEO). En Netlify se puede fijar aquí.
SITE_URL=https://tecnoscroll.es
